# AgePulse Environment Variables
# Copy to .env.local for local development

# Site URL for metadata & sitemaps (Defaults to https://agepulse.vercel.app if unset)
NEXT_PUBLIC_SITE_URL=https://agepulse.vercel.app

# Google AdSense Configuration
# Set to 'true' to enable ad rendering after Google AdSense approval
NEXT_PUBLIC_ENABLE_ADS=false

# Your Google AdSense Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
